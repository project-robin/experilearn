[Unit]
Description=ExperiLearn API
After=network-online.target
Wants=network-online.target

[Service]
User=opc
WorkingDirectory=/opt/experilearn/backend
Environment=SECRET=change-me-in-prod
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/experilearn/backend/.venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
